{
  "name": "@pesaraja/sdk",
  "version": "0.1.0",
  "description": "M-Pesa payments via Safaricom Daraja — prompt, receive, send",
  "keywords": [
    "mpesa",
    "daraja",
    "payments",
    "kenya"
  ],
  "homepage": "https://github.com/kyambuthia/a-daraja-cli#readme",
  "bugs": {
    "url": "https://github.com/kyambuthia/a-daraja-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyambuthia/a-daraja-cli.git",
    "directory": "daraja-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "lint:package": "npm run build && publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.15.29",
    "publint": "0.3.23",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
